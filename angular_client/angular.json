{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "csb-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        },
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/csb-app",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets",
              {"glob": "favicon.ico", "input": "src/assets/root_dir/app", "output": "/"},
              {"glob": "robots.txt", "input": "src/assets/root_dir/app", "output": "/"},
              {"glob": "index.php", "input": "src/assets/root_dir/app", "output": "/"},
              {"glob": "google3aa18f4eeb8da17c.html", "input": "src/assets/root_dir/app", "output": "/"}
            ],
            "styles": [
              "node_modules/@clr/icons/clr-icons.min.css",
              "src/css/app-clarity-theme.scss"
            ],
            "scripts": [
              "node_modules/@webcomponents/custom-elements/custom-elements.min.js",
              "node_modules/@clr/icons/clr-icons.min.js"

            ]
          },

          "configurations": {
            "production": {
              "index": "src/template.html",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "csb-app:build:production"
            },
            "development": {
              "browserTarget": "csb-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "csb-app:build"
          }
        }
      }
    },
    "csb-ext": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        },
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "ext",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/csb-ext",
            "index": "src/index_ext.html",
            "main": "src/main_ext.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.ext.json",
            "assets": [
              "src/assets",
              {"glob": "favicon.ico", "input": "src/assets/root_dir/ext", "output": "/"},
              {"glob": "robots.txt", "input": "src/assets/root_dir/ext", "output": "/"},
              {"glob": "index.php", "input": "src/assets/root_dir/ext", "output": "/"},
              {"glob": "google3aa18f4eeb8da17c.html", "input": "src/assets/root_dir/app", "output": "/"}
            ],
            "styles": [
              "node_modules/@clr/icons/clr-icons.min.css",
              "src/css/ext-main.scss"
            ],
            "scripts": [
              "node_modules/@webcomponents/custom-elements/custom-elements.min.js",
              "node_modules/@clr/icons/clr-icons.min.js"
            ]
          },
          "configurations": {
            "production": {
              "index": "src/template_ext.html",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "csb-ext:build:production"
            },
            "development": {
              "browserTarget": "csb-ext:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "csb-app:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
